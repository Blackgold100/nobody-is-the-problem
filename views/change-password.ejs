<%- include('partials/head') %>
<main class="narrow section" style="max-width: 460px">
  <h1 style="font-size: 32px; margin-bottom: 8px"><%= forced ? 'Choose your password' : 'Change password' %></h1>
  <p class="muted"><%= forced ? 'Replace the one-time password you were given.' : 'Use a password you don\'t use elsewhere.' %></p>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/account/password" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="current"><%= forced ? 'One-time password' : 'Current password' %></label><input id="current" name="current" type="password" required autocomplete="current-password"></div>
    <div class="field"><label for="next">New password</label><input id="next" name="next" type="password" required minlength="8" autocomplete="new-password"></div>
    <div class="field"><label for="confirm">Confirm new password</label><input id="confirm" name="confirm" type="password" required minlength="8" autocomplete="new-password"></div>
    <button class="btn btn-primary" type="submit">Save password</button>
  </form>
</main>
<%- include('partials/foot') %>
