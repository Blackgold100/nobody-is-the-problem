<%- include('partials/head') %>
<main>
  <article>
    <div class="reading-progress" data-progress aria-hidden="true"></div>
    <header class="chapter-head dark">
      <div class="narrow">
        <%- include('partials/flash') %>
        <% if (!ch.published) { %><div class="alert alert-info">Author preview: readers will see this on <%= ch.publish_on ? longDate(ch.publish_on) : 'its publish date (not set yet)' %>.</div><% } %>
        <% if (ch.part) { %><div class="part"><%= ch.part %></div><% } %>
        <div class="eyebrow"><%= chLabel(ch) %></div>
        <h1 style="font-size: clamp(30px, 5vw, 46px); margin-top: 8px"><%= ch.title %></h1>
        <% if (ch.teaser) { %><p class="epigraph"><%= ch.teaser %></p><% } %>
        <div class="chapter-meta" style="margin-top: 14px">
          <span><%= Math.max(1, Math.round(String(ch.commentary || '').split(/\s+/).length / 230)) %> min read</span>
          <% if (reviews.length) { %><span><%- include('partials/stars', { value: avg }) %> <%= avg.toFixed(1) %> from <%= reviews.length %> reader<%= reviews.length === 1 ? '' : 's' %></span><% } %>
          <% if (ch.is_free) { %><span class="pill pill-free">Free to read</span><% } %>
        </div>
      </div>
    </header>

    <div class="narrow stack" style="gap: 36px">
      <% if (access) { %>
        <% if (commentaryHtml) { %><section class="prose reading" aria-label="Chapter text" data-reading><%- commentaryHtml %></section><% } %>

        <% if (notes.length) { %>
        <section class="notes" aria-label="Notes" id="notes">
          <h2>Notes</h2>
          <ol><% notes.forEach(function (n) { %><li id="note-<%= n[0] %>" value="<%= n[0] %>"><%- inlineMd(n[1]) %> <a class="back" href="#ref-<%= n[0] %>" aria-label="Back to the text">↩</a></li><% }) %></ol>
        </section>
        <% } %>

        <% if (lines(ch.key_ideas).length) { %>
        <section class="card" aria-label="Key ideas">
          <h2 style="font-size: 22px; margin-bottom: 14px">In this chapter</h2>
          <ul class="ideas"><% lines(ch.key_ideas).forEach(function (k) { %><li><span><%= k %></span></li><% }) %></ul>
        </section>
        <% } %>

        <% if (lines(ch.questions).length) { %>
        <section id="journal" aria-label="Reflect">
          <h2 style="font-size: 24px; margin-bottom: 4px">Institutional Mirror</h2>
          <p class="muted" style="margin: 0 0 12px">Questions to sit with. Your answers are private.</p>
          <ol style="padding-left: 22px; margin: 0 0 18px; font-size: 17px; color: var(--ink-2)"><% lines(ch.questions).forEach(function (q) { %><li style="margin-bottom: 8px"><%= q %></li><% }) %></ol>
          <% if (user) { %>
          <form method="post" action="/chapters/<%= ch.slug %>/journal" class="stack" style="gap: 10px">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label for="journal-body" class="label-txt">Your reflections <span class="muted" style="font-weight: 400">(private, only you can see this)</span></label>
            <textarea id="journal-body" name="body" rows="6" placeholder="Write your answers here…"><%= journal ? journal.body : '' %></textarea>
            <div class="form-actions"><button class="btn btn-primary btn-sm" type="submit">Save reflections</button><% if (journal) { %><span class="hint">Last saved <%= longDate(journal.updated_at) %></span><% } %></div>
          </form>
          <% } else { %>
          <p class="muted"><a href="/login?next=/chapters/<%= ch.slug %>%23journal">Sign in</a> or <a href="/signup?next=/chapters/<%= ch.slug %>">create a free account</a> to save your reflections.</p>
          <% } %>
        </section>
        <% } %>

        <% if (lines(ch.quotes).length) { %>
        <section aria-label="Share a quote">
          <h2 style="font-size: 24px; margin-bottom: 6px">Share a line</h2>
          <p class="muted" style="margin-bottom: 8px">Turn a line into an image for WhatsApp, Instagram or your status.</p>
          <div data-quote-cards data-title="<%= site.book_title %>" data-author="<%= site.author_name %>" data-chapter="<%= chLabel(ch) %>: <%= ch.title %>">
            <% lines(ch.quotes).forEach(function (q) { %>
            <div class="quote-item"><q><%= q %></q><button type="button" class="btn btn-outline btn-sm" data-make-card="<%= q %>">Make a card</button></div>
            <% }) %>
            <div class="quote-preview" data-preview>
              <img alt="Quote card preview" data-preview-img>
              <div class="form-actions" style="justify-content: center; margin-top: 12px">
                <a class="btn btn-primary btn-sm" data-download download="quote-card.png" href="#">Download image</a>
                <button type="button" class="btn btn-outline btn-sm" data-share hidden>Share</button>
              </div>
            </div>
          </div>
        </section>
        <% } %>
      <% } else { %>
        <% if (previewHtml) { %><section class="prose reading faded" style="max-height: 420px"><%- previewHtml %></section><% } %>
        <div class="paywall">
          <div class="card stack" style="gap: 12px">
            <div class="eyebrow">Keep reading</div>
            <h2 style="font-size: 26px">Unlock the rest of the book</h2>
            <p class="muted" style="margin: 0">Donate any amount from <strong><%= naira(site.donation_min_ngn) %></strong> by bank transfer to support the author and unlock all 24 chapters, the Epilogue, the notes, the reflection journal and quote cards.</p>
            <div class="form-actions" style="justify-content: center"><a class="btn btn-clay" href="/pass">Donate to keep reading</a></div>
            <% if (user) { %><p class="muted" style="margin: 0; font-size: 14px">Already sent a transfer? <a href="/pass">Tell us here</a> and it unlocks once confirmed.</p><% } %>
            <% if (!user) { %><p class="muted" style="margin: 0; font-size: 14px">Already donated? <a href="/login?next=/chapters/<%= ch.slug %>">Sign in</a></p><% } %>
          </div>
        </div>
      <% } %>

      <section id="reviews" aria-label="Reader reviews">
        <h2 style="font-size: 24px; margin-bottom: 4px">What readers say</h2>
        <% if (reviews.length) { %>
          <div><% reviews.forEach(function (r) { %>
            <div class="review">
              <div class="review-head"><span><strong><%= r.name.split(' ')[0] %></strong> · <%- include('partials/stars', { value: r.rating }) %></span><span><%= longDate(r.created_at) %></span></div>
              <p><%= r.body %></p>
            </div>
          <% }) %></div>
        <% } else { %><p class="muted">No reviews yet<%= access ? '. Be the first to share what this chapter meant to you.' : '.' %></p><% } %>

        <% if (access && user) { %>
        <form method="post" action="/chapters/<%= ch.slug %>/review" class="card stack" style="margin-top: 20px; gap: 12px">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <h3><%= mine ? 'Update your review' : 'Review this chapter' %></h3>
          <% if (mine) { %><p class="hint" style="margin: 0"><%= mine.status === 'pending' ? 'Your review is waiting for the author to read it.' : mine.status === 'approved' ? 'Your review is published. Editing it sends it back for approval.' : 'Your review isn\'t shown publicly.' %></p><% } %>
          <fieldset style="border: 0; padding: 0; margin: 0">
            <legend class="label-txt">Your rating</legend>
            <div class="star-input">
              <% for (let i = 5; i >= 1; i--) { %><input type="radio" id="star-<%= i %>" name="rating" value="<%= i %>" <%= mine && mine.rating === i ? 'checked' : '' %> required><label for="star-<%= i %>" title="<%= i %> star<%= i === 1 ? '' : 's' %>">★<span class="sr-only"><%= i %> star<%= i === 1 ? '' : 's' %></span></label><% } %>
            </div>
          </fieldset>
          <div class="field"><label for="review-body">Your review</label><textarea id="review-body" name="body" rows="4" maxlength="2000" required placeholder="What stayed with you from this chapter?"><%= mine ? mine.body : '' %></textarea></div>
          <div><button class="btn btn-primary btn-sm" type="submit"><%= mine ? 'Update review' : 'Submit review' %></button></div>
        </form>
        <% } else if (access && !user) { %>
        <p class="muted" style="margin-top: 12px"><a href="/login?next=/chapters/<%= ch.slug %>%23reviews">Sign in</a> or <a href="/signup?next=/chapters/<%= ch.slug %>">create a free account</a> to review this chapter.</p>
        <% } %>
      </section>

      <nav class="chapter-nav" aria-label="Chapters">
        <% if (prev) { %><a href="/chapters/<%= prev.slug %>">← <%= chLabel(prev) %>: <%= prev.title %></a><% } else { %><span></span><% } %>
        <% if (next) { %><a href="/chapters/<%= next.slug %>" style="text-align: right"><%= chLabel(next) %>: <%= next.title %> →</a><% } %>
      </nav>
    </div>
  </article>
</main>
<%- include('partials/foot') %>
