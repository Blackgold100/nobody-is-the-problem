<% if (!chapters.length) { %>
  <div class="card empty">The first chapter is on its way.</div>
<% } else { %>
<div class="chapter-list">
  <% let lastPart = '__none__'; chapters.forEach(function (c) { const open = c.published; const unlocked = c.is_free || (user && (user.has_pass || user.role === 'author'));
     const part = c.part || null;
     if (typeof grouped !== 'undefined' && grouped && part !== lastPart && part) { const bits = part.split(' — '); %>
    <div class="part-head"><%= bits[0] %><% if (bits[1]) { %><span><%= bits[1] %></span><% } %></div>
  <% } if (typeof grouped !== 'undefined' && grouped && !part && lastPart !== '__none__' && lastPart !== null) { %><div class="part-head">Closing</div><% } lastPart = part; %>
    <% if (open) { %><a class="chapter-row" href="/chapters/<%= c.slug %>"><% } else { %><div class="chapter-row upcoming"><% } %>
      <span class="chapter-num"><%= c.label && !/^Chapter /.test(c.label) ? '◆' : c.number %></span>
      <span class="chapter-main">
        <% if (c.label && !/^Chapter /.test(c.label)) { %><span class="muted" style="font-size: 13px; text-transform: uppercase; letter-spacing: .08em"><%= c.label %></span><% } %>
        <h3><%= c.title === c.label ? '' : c.title %><%= c.title === c.label ? c.label : '' %></h3>
        <span class="chapter-meta">
          <% if (!open) { %><span class="pill pill-soon">Coming <%= longDate(c.publish_on) %></span>
          <% } else if (c.is_free) { %><span class="pill pill-free">Free to read</span>
          <% } else if (unlocked) { %><span class="pill pill-teal">Unlocked</span>
          <% } else { %><span class="pill pill-lock">🔒 Unlock with a donation</span><% } %>
          <% if (c.words) { %><span><%= Math.max(1, Math.round(c.words / 230)) %> min read</span><% } %>
          <% if (c.review_count) { %><span><%- include('stars', { value: c.avg_rating }) %> <%= c.review_count %> review<%= c.review_count === 1 ? '' : 's' %></span><% } %>
        </span>
        <% if (c.teaser) { %><span class="muted" style="display: block; margin-top: 6px; font-size: 15px; font-style: italic"><%= c.teaser.length > 170 ? c.teaser.slice(0, 167) + '…' : c.teaser %></span><% } %>
      </span>
    <% if (open) { %></a><% } else { %></div><% } %>
  <% }) %>
</div>
<% } %>
