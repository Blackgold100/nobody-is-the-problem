# Local development only. On Replit, use the Secrets tool instead.
DATABASE_URL=postgres://user:password@localhost:5432/book
SESSION_SECRET=replace-with-64-random-characters
AUTHOR_EMAIL=you@example.com
# AUTHOR_PASSWORD=optional; if empty a one-time password is printed in the console
# PUBLIC_URL=https://your-domain.com   (optional; used for link previews)
# PAYSTACK_SECRET_KEY=   (optional; leave unset to accept bank transfers only)
